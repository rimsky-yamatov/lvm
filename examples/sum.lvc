// input: 4
// input: 10 20 30 41
// output: sum=101 avg=25.25
// reads a count and then that many numbers
int main() {
    int n;
    scanf("%d", &n);
    int sum = 0;
    for (int i = 0; i < n; i++) {
        int x;
        scanf("%d", &x);
        sum += x;
    }
    printf("sum=%d avg=%.2f\n", sum, sum / (float)n);
    return 0;
}
