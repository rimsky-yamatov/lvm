; expect: 49
; Each Jcc skips an ADD when its condition holds. For 3 and 5 the
; conditions EQ, GT and GE are false, so 1 + 16 + 32 are added.
main:
    LDI R0, 3
    LDI R1, 5
    LDI R2, 0
    LDI R3, 1
    LDI R4, 2
    LDI R5, 4
    LDI R6, 8
    LDI R7, 16
    LDI R8, 32
    JEQ R0, R1, .s1
    ADD R2, R2, R3
.s1:
    JNE R0, R1, .s2
    ADD R2, R2, R4
.s2:
    JLT R0, R1, .s3
    ADD R2, R2, R5
.s3:
    JLE R0, R1, .s4
    ADD R2, R2, R6
.s4:
    JGT R0, R1, .s5
    ADD R2, R2, R7
.s5:
    JGE R0, R1, .s6
    ADD R2, R2, R8
.s6:
    RET R2
