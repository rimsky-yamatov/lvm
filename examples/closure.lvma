; expect: 5
; a counter closure: both calls share the captured variable in R0
main:
    LDI R0, 0
    CLOSURE R1, counter
    MOV R2, R1
    CALLC R2, 0          ; 1
    MOV R3, R1
    CALLC R3, 0          ; 2
    ADD R4, R2, R3       ; 3
    ADD R4, R4, R0       ; + the shared variable (2)
    RET R4

counter:
    .upval stack R0
    GETUP R0, 0
    LDI R1, 1
    ADD R0, R0, R1
    SETUP R0, 0
    RET R0
